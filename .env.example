# VF dashboard environment configuration (names only — no real values here).
# Copy to a local, untracked `.env` for development, or set these in Vercel's
# per-environment settings for Preview / Production.

# Google Sheets workbook id (the long id from the sheet URL).
GOOGLE_SHEET_ID=

# Full service-account JSON as a single string (the entire credentials file
# contents). Locally you may instead keep a credentials.json file.
GOOGLE_CREDENTIALS=

# Shared secret the Jarvis proxy injects as the X-Jarvis-Proxy-Token header.
# Use different values for Preview and Production.
JARVIS_PROXY_SECRET=

# Optional limits (defaults shown).
MAX_REQUEST_BYTES=1048576
GOOGLE_REQUEST_TIMEOUT_SECONDS=10
